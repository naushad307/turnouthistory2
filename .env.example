# MongoDB Atlas connection
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/replacement_history?retryWrites=true&w=majority

# Secret used to sign edit-session JWTs
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Backend URL used by the frontend.
# Same deployment: leave blank.
# Separate frontend/backend: e.g. https://your-backend.onrender.com
BACKEND_URL=

PORT=3000
